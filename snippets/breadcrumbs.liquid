{% unless template == 'index' or template == 'cart' or template == 'list-collections' %}
<div class="main-breadcrumbs">
<div class="page-width">  
<nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">

  <a href="/" title="Home" class="text-white"><i class="fa fa-home font-18"></i></a>




  

  {% if template contains 'page' %}

    <i class="fa fa-chevron-right"></i>

    <span>{{ page.title }}</span>




  

  {% elsif template contains 'product' %}

    {%- assign breadcrumb_collection = collection | default: product.collections.first -%}
    <span class="url">
      <i class="fa fa-chevron-right"></i>
      <a href="{{ routes.collections_url }}" class="text-white">Collections</a>
      {%- if breadcrumb_collection and breadcrumb_collection.handle -%}
        <i class="fa fa-chevron-right"></i>
        <a href="{{ breadcrumb_collection.url }}" class="text-white">{{ breadcrumb_collection.title }}</a>
      {%- endif -%}
      <i class="fa fa-chevron-right"></i>
      <span>{{ product.title }}</span>
    </span>



  
  {% elsif template contains 'collection' and collection.handle %}

    <i class="fa fa-chevron-right"></i>

    {% if current_tags %}

      {% capture url %}/collections/{{ collection.handle }}{% endcapture %}

      {{ collection.title | link_to: url }}

     &rsaquo;

      <span>{{ current_tags | join: " + " }}</span>

    {% else %}
 
      <span class="coll"><a href="{{ routes.collections_url }}" class="text-white">Collections</a> <i class="fa fa-chevron-right"></i> {{ collection.title }}</span>

    {% endif %}




  
  {% elsif template == 'blog' %}

   <i class="fa fa-chevron-right"></i>

    {% if current_tags %}

      {{ blog.title | link_to: blog.url }}

      <i class="fa fa-chevron-right"></i>

      <span>{{ current_tags | join: " + " }}</span>

    {% else %}

    <span>{{ blog.title }}</span>

    {% endif %}



  

  {% elsif template == 'article' %}

    <i class="fa fa-chevron-right"></i>

    {{ blog.title | link_to: blog.url }}

    <i class="fa fa-chevron-right"></i>

    <span>{{ article.title }}</span>

  {% else %}

   <i class="fa fa-chevron-right"></i>

   <span>{{ page_title }}</span>

  {% endif %}


  
</nav>
</div> 
</div>

{% endunless %} 