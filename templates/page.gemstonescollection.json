eed","icon":"none","row_content":"<p>At AstroMall, your privacy and security is our top priority. We adopt the highest security standards to keep your data and information secure. We ensure complete anonymity of your personal data, and any other information that you share with our Astrologers. Our platform operates in a 100% secure setting, so you can connect online with Astrologers without worrying about anything.<\/p>","page":""}}},"block_order":["template--18870167961915__33cd8be4-9649-4476-8edb-cccd5aaf9fb4-16825929461f138f83-0","template--18870167961915__33cd8be4-9649-4476-8edb-cccd5aaf9fb4-16825929461f138f83-1","template--18870167961915__33cd8be4-9649-4476-8edb-cccd5aaf9fb4-16825929461f138f83-2"],"settings":{"caption":"One of the best online Astrology platforms to connect with experienced and verified Astrologers","heading":"WHY ASTRO MALL?","heading_size":"h2","heading_alignment":"center","layout":"none","color_scheme":"background-2","container_color_scheme":"background-2","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}},"d90b1158-1094-4862-87b0-8b8eefeb50eb":{"type":"multicolumn","blocks":{"template--18870167961915__d90b1158-1094-4862-87b0-8b8eefeb50eb-16825933388c33cde7-0":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/certificate.svg","title":"CERTIFIED PRODUCTS","text":"","link_label":"","link":""}},"template--18870167961915__d90b1158-1094-4862-87b0-8b8eefeb50eb-16825933388c33cde7-1":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/shipped.svg","title":"WORLDWIDE SHIPPING","text":"","link_label":"","link":""}},"template--18870167961915__d90b1158-1094-4862-87b0-8b8eefeb50eb-16825933388c33cde7-2":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/settings.svg","title":"ENERGIZED & ACTIVATED","text":"","link_label":"","link":""}},"239153b7-c711-4236-b44b-61ee74096d17":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/investmen