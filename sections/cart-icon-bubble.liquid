{%- comment -%}
  Rendered into #cart-icon-bubble by cart-drawer.js / cart-notification.js after
  every cart update, so this must mirror the cart icon in snippets/store-header.liquid.
{%- endcomment -%}
{%- render 'store-header-icon', name: 'cart' -%}
<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  <span class="sh-cart-bubble">
    {%- if cart.item_count < 100 -%}
      <span aria-hidden="true">{{ cart.item_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
  </span>
{%- endif -%}
