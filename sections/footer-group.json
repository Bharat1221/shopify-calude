     </div>\n \n      <!-- Col 4: Download Apps + Social -->\n      <div class=\"ata-footer__col\">\n        <span class=\"ata-footer__col-title\">Download Our Apps</span>\n \n        <div class=\"ata-footer__apps\">\n          <a href=\"https://play.google.com/store/apps/details?id=com.dashaspeaks.astrology.online.chat\" target=\"_blank\" rel=\"noopener\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/google-play.png\" alt=\"Get it on Google Play\" />\n          </a>\n          <a href=\"https://apps.apple.com/in/app/anytime-astro-live-chat-talk/id1536125164\" target=\"_blank\" rel=\"noopener\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/app-store.png\" alt=\"Available on App Store\" />\n          </a>\n        </div>\n \n        <!-- Social icons -->\n        <div class=\"ata-footer__social\">\n          <a href=\"https://www.facebook.com/anytimeastro/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Facebook\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/fb.svg\" alt=\"Facebook\" />\n          </a>\n          <a href=\"https://twitter.com/AnytimeAstro\" target=\"_blank\" rel=\"noopener\" aria-label=\"Twitter / X\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/twitter.svg\" alt=\"Twitter\" />\n          </a>\n          <a href=\"https://www.linkedin.com/company/anytime-astro/\" target=\"_blank\" rel=\"noopener\" aria-label=\"LinkedIn\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/linkedin.svg\" alt=\"LinkedIn\" />\n          </a>\n          <a href=\"https://www.instagram.com/anytimeastro/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Instagram\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/insta.svg\" alt=\"Instagram\" />\n          </a>\n          <a href=\"https://www.youtube.com/channel/UCKMy6D0GnSJTGg9ZpR0wAUg\" target=\"_blank\" rel=\"noopener\" aria-label=\"YouTube\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/youtubene.svg\" alt=\"YouTube\" />\n          </a>\n          <a href=\"https://in.pinterest.com/anytimeastro/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Pinterest\">\n            <img src=\"https://cdn.anytimeastro.com/anytimeastro/store/web/images/pinterest.svg\" alt=\"Pinterest\" />\n          </a>\n        </div>\n      </div>\n \n    </div><!-- /.ata-footer__cols -->\n  </div><!-- /.ata-footer__body -->\n \n  <!-- Copyright bar -->\n  <div class=\"ata-footer__copyright\">\n    Copyright &copy; 2020-2026 Innovana Astro Services Ltd. All Rights Reserved\n  </div>\n \n</footer>",
