      "settings": {
        "custom_liquid": "<style>\n \n  /* ── Reset scoped to footer ── */\n  .ata-footer,\n  .ata-footer * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n \n  /* ══════════════════════════════════════════\n     MAIN FOOTER BODY\n  ══════════════════════════════════════════ */\n  .ata-footer {\n    background-color: #8b1a2a;\n    color: #ffffff;\n    font-family: 'Segoe UI', Arial, sans-serif;\n    font-size: 14px;\n    width: 100%;\n  }\n \n  .ata-footer__body {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 48px 24px 36px;\n  }\n \n  /* ── About block ── */\n  .ata-footer__about {\n    padding-bottom: 28px;\n    border-bottom: 1px solid rgba(255,255,255,0.2);\n    margin-bottom: 36px;\n  }\n \n  .ata-footer__about-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #ffffff;\n    margin-bottom: 12px;\n  }\n \n  .ata-footer__about-text {\n    font-size: 14px;\n    color: rgba(255,255,255,0.85);\n    line-height: 1.75;\n    max-width: 900px;\n  }\n \n  /* ── 4-column grid ── */\n  .ata-footer__cols {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 32px;\n    align-items: start;\n  }\n \n  /* ── Column heading ── */\n  .ata-footer__col-title {\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    margin-bottom: 18px;\n    display: block;\n  }\n \n  /* ── Link list ── */\n  .ata-footer__list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n \n  .ata-footer__list li a {\n    color: rgba(255,255,255,0.80);\n    text-decoration: none;\n    font-size: 13.5px;\n    line-height: 1.4;\n    transition: color 0.2s ease;\n    display: inline-block;\n  }\n \n  .ata-footer__list li a:hover {\n    color: #f5c518;\n    text-decoration: underline;\n  }\n \n  /* ── Policy sub-heading ── */\n  .ata-footer__col-subtitle {\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    margin: 24px 0 14px;\n    display: block;\n  }\n \n  /* ── App badges ── */\n  .ata-footer__apps {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    margin-bottom: 20px;\n  }\n \n  .ata-footer__apps a {\n    display: inline-block;\n    transition: opacity 0.2s;\n  }\n \n  .ata-footer__apps a:hover { opacity: 0.85; }\n \n  .ata-footer__apps img {\n    height: 44px;\n    width: auto;\n    display: block;\n  }\n \n  /* ── Social icons row ── */\n  .ata-footer__social {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin-top: 4px;\n  }\n \n  .ata-footer__social a {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    background: rgba(255,255,255,0.12);\n    transition: background 0.2s, transform 0.2s;\n    overflow: hidden;\n  }\n \n  .ata-footer__social a:hover {\n    background: rgba(255,255,255,0.28);\n    transform: translateY(-2px);\n  }\n \n  .ata-footer__social img {\n    width: 20px;\n    height: 20px;\n    object-fit: contain;\n    display: block;\n    filter: brightness(0) invert(1);  /* force white */\n  }\n \n  /* ══════════════════════════════════════════\n     COPYRIGHT BAR\n  ══════════════════════════════════════════ */\n  .ata-footer__copyright {\n    background-color: #5c0f1e;\n    text-align: center;\n    padding: 14px 24px;\n    font-size: 13px;\n    color: rgba(255,255,255,0.80);\n    letter-spacing: 0.2px;\n  }\n \n  /* ══════════════════════════════════════════\n     RESPONSIVE\n  ══════════════════════════════════════════ */\n \n  /* Tablet ≤ 900px → 2 columns */\n  @media (max-width: 900px) {\n    .ata-footer__cols {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 28px;\n    }\n  }\n \n  /* Mobile ≤ 540px → 1 column */\n  @media (max-width: 540px) {\n    .ata-footer__body {\n      padding: 32px 16px 28px;\n    }\n \n    .ata-footer__cols {\n      grid-template-columns: 1fr;\n      gap: 28px;\n    }\n \n    .ata-footer__about {\n      margin-bottom: 28px;\n      padding-bottom: 20px;\n    }\n \n    .ata-footer__col-title,\n    .ata-footer__col-subtitle {\n      font-size: 14px;\n    }\n \n    .ata-footer__apps img {\n      height: 40px;\n    }\n  }\n</style>\n \n<!-- ══════════════════════════════════════════\n     FOOTER MARKUP\n══════════════════════════════════════════ -->\n<footer class=\"ata-footer\">\n \n  <div class=\"ata-footer__body\">\n \n    <!-- About -->\n    <div class=\"ata-footer__about\">\n      <p class=\"ata-footer__about-title\">About Anytime Astro</p>\n      <p class=\"ata-footer__about-text\">\n        Anytime Astro is the best astrology website for all types of online astrology consultations\n        with India's best astrologers. It is an excellent option for those seeking instant,\n        personalized, and empathetic astrology guidance related to marriage, career, relationships,\n        health and more through call or chat with experienced astrologers. You can explore your future\n        possibilities by connecting with our astrologers for accurate kundali predictions.\n      </p>\n    </div>\n \n    <!-- 4 columns -->\n    <div class=\"ata-footer__cols\">\n \n      <!-- Col 1: Buy Products -->\n      <div class=\"ata-footer__col\">\n        <span class=\"ata-footer__col-title\">Buy Products</span>\n        <ul class=\"ata-footer__list\">\n          <li><a href=\"https://www.anytimeastro.com/store/products/brclt/\" target=\"_blank\">Bracelet</a></li>\n          <li><a href=\"https://www.anytimeastro.com/store/products/rudksh/\" target=\"_blank\">Rudraksha Bead</a></li>\n          <li><a href=\"https://www.anytimeastro.com/store/products/gem/\" target=\"_blank\">Gemstone</a></li>\n          <li><a href=\"https://www.anytimeastro.com/store/products/yntr/\" target=\"_blank\">Yantra</a></li>\n          <li><a href=\"https://www.anytimeastro.com/store/products/kvch/\" target=\"_blank\">Kavach</a></li>\n          <li><a href=\"https://www.anytimeastro.com/store/products/combo/